<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 自建服务多半是内网 http，允许明文，否则 WebView 会直接拦截 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
