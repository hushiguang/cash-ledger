# 用法：cp .env.example .env，然后按需修改

# 登录密钥。留空会自动生成并存在 data/jwt.secret；
# 换值会让所有人重新登录，所以部署后不要随意改。
JWT_SECRET=

# 是否开放注册。第一个注册的账号自动成为管理员，之后建议改成 false。
ALLOW_REGISTER=true

# 图床（EasyImages2.0），账单图片上传用。换成你自己的地址和 token。
IMAGE_HOST_URL=https://xxxx/api/index.php
IMAGE_HOST_TOKEN=xxx

# 服务端口和时区
PORT=10091
TZ=Asia/Shanghai

# 宿主机数据目录（数据库、jwt.secret 都放这里），映射到容器 /data
DATA_PATH=/vol1/1000/docker/cash/data

# 容器内数据目录，一般不用改
DATA_DIR=/data
