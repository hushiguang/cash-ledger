# 用法：cp .env.example .env，然后按需修改

# 登录密钥。留空会自动生成并存在 data/jwt.secret；
# 换值会让所有人重新登录，所以部署后不要随意改。
JWT_SECRET=

# 是否开放注册。第一个注册的账号自动成为管理员，之后建议改成 false。
ALLOW_REGISTER=true

# 图床（EasyImages2.0），账单图片上传用。换成你自己的地址和 token。
IMAGE_HOST_URL=https://image.coooo.tech:1443/api/index.php
IMAGE_HOST_TOKEN=1c17b11693cb5ec63859b091c5b9c1b2

# 服务端口和时区
PORT=8080
TZ=Asia/Shanghai

# 容器内数据目录，对应 docker-compose 里的 ./data:/data
DATA_DIR=/data
